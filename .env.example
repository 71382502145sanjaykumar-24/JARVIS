# ==========================================
# JARVIS AI ASSISTANT CONFIGURATION
# ==========================================

# OpenAI API Key (Obtain from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (e.g. gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Voice Configuration
VOICE_RATE=180
VOICE_VOLUME=1.0
VOICE_ENGINE=pyttsx3
SPEECH_ENABLED=true

# Automation Settings (Safety First)
AUTOMATION_ENABLED=true
REQUIRE_CONFIRMATION=true
SAFE_MODE=true

# Application UI Settings
THEME_MODE=dark
ACCENT_COLOR=cyan
START_MINIMIZED=false

